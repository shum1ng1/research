{
  "type": "object",
  "required": [
    "ticker",
    "as_of",
    "ratios",
    "assessment",
    "bull_case",
    "bear_case",
    "confidence",
    "sources_cited"
  ],
  "properties": {
    "ticker": { "type": "string" },
    "as_of": { "type": "string", "description": "ISO date or period label from DATA" },
    "ratios": {
      "type": "object",
      "properties": {
        "pe": { "type": ["number", "null"] },
        "debt_to_equity": { "type": ["number", "null"] },
        "current_ratio": { "type": ["number", "null"] },
        "gross_margin": { "type": ["number", "null"] }
      },
      "required": ["pe", "debt_to_equity", "current_ratio", "gross_margin"]
    },
    "assessment": {
      "type": "object",
      "properties": {
        "growth": { "type": "string" },
        "profitability": { "type": "string" },
        "solvency": { "type": "string" },
        "overall_health": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1=weak … 5=strong"
        }
      },
      "required": ["growth", "profitability", "solvency", "overall_health"]
    },
    "bull_case": { "type": "string" },
    "bear_case": { "type": "string" },
    "confidence": { "enum": ["high", "medium", "low"] },
    "sources_cited": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
