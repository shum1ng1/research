# HKU Student GenAI Services — Azure DeepSeek (Foundry) gateway (default)
# Get primary key from https://developer.hku.hk/profile (Student GenAI subscription)
HKU_GENAI_API_KEY=

# Foundry DeepSeek (recommended)
HKU_GENAI_BASE_URL=https://api.hku.hk/foundry/student
# Model id (also accepted as HKU_GENAI_MODEL). Prefer DeepSeek-V3.2.
# Alternatives: DeepSeek-V4-Flash, DeepSeek-V4-Pro
HKU_GENAI_DEPLOYMENT=DeepSeek-V3.2
# HKU_GENAI_MODEL=DeepSeek-V3.2

# Quotas (approx): ~3/min, 300/day, 900/month; portal may cap DeepSeek ~500/day.
# No api-version query param on Foundry.

# --- Optional: Azure OpenAI student gateway instead ---
# HKU_GENAI_BASE_URL=https://api.hku.hk/openai/student
# HKU_GENAI_DEPLOYMENT=gpt-4.1-mini
# HKU_GENAI_API_VERSION=2025-04-01-preview
