# Copy this file to .env and fill values on your own computer.
# .env is gitignored. Do not commit it or paste keys into chat.
#
# Offline demo does not need any of these values.

# Official DeepSeek API key (https://platform.deepseek.com/). Used only by
# `python3 -m integration --live --provider deepseek`.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# SEC fair-access header. Not an API key, but it must contain a real contact
# email when you run live collection. Keep it in .env so it is not committed.
# Shape: project-name you@example.com
SEC_USER_AGENT=

# HKU Student GenAI Services — Azure gateway. Used only with --provider hku.
# This is not the official DeepSeek API.
# Get a primary key from https://developer.hku.hk/profile (Student GenAI subscription)
HKU_GENAI_API_KEY=

# Foundry DeepSeek (recommended)
HKU_GENAI_BASE_URL=https://api.hku.hk/foundry/student
# Model id (also accepted as HKU_GENAI_MODEL). Prefer DeepSeek-V3.2.
# Alternatives: DeepSeek-V4-Flash, DeepSeek-V4-Pro
HKU_GENAI_DEPLOYMENT=DeepSeek-V3.2
# HKU_GENAI_MODEL=DeepSeek-V3.2

# Quotas (approx): ~3/min, 300/day, 900/month; portal may cap DeepSeek ~500/day.
# No api-version query param on Foundry.

# --- Optional: Azure OpenAI student gateway instead ---
# HKU_GENAI_BASE_URL=https://api.hku.hk/openai/student
# HKU_GENAI_DEPLOYMENT=gpt-4.1-mini
# HKU_GENAI_API_VERSION=2025-04-01-preview
